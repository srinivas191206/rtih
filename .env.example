# ─────────────────────────────────────────────────────────────
# RTIH InnovationOS — Environment Variables Template
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Database & Realtime) ───────────────────────────
# Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: NEXT_PUBLIC_* variables are intentionally browser-exposed.
# The Supabase anon key is safe to expose — it is protected by
# Row Level Security (RLS) policies on your Supabase project.

# ── Google Gemini AI ──────────────────────────────────────────
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── OpenRouter (Fallback AI) ──────────────────────────────────
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Groq AI (Fallback AI, supports key rotation pool) ────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-primary-groq-api-key

# Optional: comma-separated pool of additional Groq keys for
# automatic rate-limit failover (leave blank if using one key)
GROQ_API_KEYS_POOL=key1,key2,key3
